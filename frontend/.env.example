# Sao chép thành .env khi cần đổi mặc định.

# Đích mà Vite dev server proxy các request /api/* tới.
# - Máy chạy backend: để trống (mặc định http://localhost:8000)
# - Máy thứ hai chạy Vite riêng: trỏ về máy chủ backend
#   VITE_PROXY_TARGET=http://192.168.8.104:8000
VITE_PROXY_TARGET=

# Cổng dev server.
VITE_PORT=5173

# Chỉ đặt khi KHÔNG dùng proxy ở trên, ví dụ khi build tĩnh rồi phục vụ riêng.
# VITE_API_BASE=http://192.168.8.104:8000
