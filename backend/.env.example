# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env lên git.

# Khóa của LiveKit server. Phải khớp với mục `keys:` trong livekit/livekit.yaml.
# Phải khớp từng ký tự với mục `keys:` trong livekit/livekit.yaml.example.
# Đây là khóa dev dùng chung, KHÔNG dùng cho production.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret

# Địa chỉ LiveKit mà BROWSER sẽ kết nối tới.
# Để trống -> backend tự dò: ưu tiên IP Tailscale, không có thì lấy IP LAN.
# Giá trị này PHẢI khớp node_ip mà scripts/start-livekit.ps1 in ra, nếu không
# browser sẽ kết nối tới một địa chỉ không có media.
# Đặt tay khi cần, ví dụ: ws://100.82.57.5:7880
LIVEKIT_URL=

# Thời hạn của join token, tính bằng giờ.
TOKEN_TTL_HOURS=6

# Chỉ dùng cho dev. Production phải liệt kê origin cụ thể, ví dụ:
# CORS_ORIGINS=http://192.168.8.104:5173,http://localhost:5173
CORS_ORIGINS=*
